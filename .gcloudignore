# What `gcloud run deploy --source .` uploads as the Cloud Build context.  Written explicitly
# rather than left to gcloud's .gitignore translation, so the build context is the same set of
# files on every machine.  The image's own COPY list is narrower still (see Dockerfile) and
# .dockerignore prunes what reaches the daemon; this file only bounds the upload.
.git
.gcloudignore
.github
.venv
.env
.env.*
!.env.example
.hf
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
runs/
data/chroma/
*.db
*.sqlite3
eval/results/
tests/
docs/
deploy/
web/*.gif
.DS_Store
