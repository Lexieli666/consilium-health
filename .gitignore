# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Runtime artifacts
runs/
data/chroma/
*.db
*.sqlite3

# Evaluation results: only the published runs are committed, timestamped runs are not.
# `published/` is the legacy ablation run (gpt-4o-mini, bge index); `published-langgraph/` and
# `published-legacy-haiku/` are the paired ORCHESTRATOR=langgraph / legacy runs on claude-haiku-5-5
# with the offline hash retriever, in the same layout
# (`python -m eval.publish --from <run> --out eval/results/<name>`).
eval/results/*
!eval/results/published/
!eval/results/published-langgraph/
!eval/results/published-legacy-haiku/

# Reference material that lives in the PARENT directory.  These patterns are anchored with a
# leading slash on purpose: an unanchored `config.py` would also match `consilium/config.py`,
# which is a source file, and would silently drop it from the repository.
/medix-agent-swarm/
/MediX-R1/
/config.py
*.pdf

# OS
.DS_Store
Thumbs.db
