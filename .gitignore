# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Runtime artifacts
runs/
data/chroma/
# A local Hugging Face hub cache (point HF_HUB_CACHE at it with HF_HUB_OFFLINE=1 where the hub is unreachable)
.hf/
*.db
*.sqlite3

# Evaluation results: only the published runs are committed, timestamped runs are not.
# `published/` is the legacy ablation run (gpt-4o-mini, bge index).  The `published-haiku-*`
# directories are the paired claude-haiku-5-5 runs behind docs/LANGGRAPH_EVAL.md, in the same
# layout (`python -m eval.publish --from <run> --out eval/results/<name>`): `hash` = the offline
# HashEmbedder/NumpyStore pipeline, `bge` = the bge-small/Chroma index; `legacy`,
# `langgraph-v1` (planner decides every tool call) and `langgraph-v2` (search_knowledge first).
eval/results/*
!eval/results/published/
!eval/results/published-haiku-hash-legacy/
!eval/results/published-haiku-hash-langgraph-v1/
!eval/results/published-haiku-bge-legacy/
!eval/results/published-haiku-bge-langgraph-v1/
!eval/results/published-haiku-bge-langgraph-v2/

# Reference material that lives in the PARENT directory.  These patterns are anchored with a
# leading slash on purpose: an unanchored `config.py` would also match `consilium/config.py`,
# which is a source file, and would silently drop it from the repository.
/medix-agent-swarm/
/MediX-R1/
/config.py
*.pdf

# OS
.DS_Store
Thumbs.db
