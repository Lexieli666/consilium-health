# Copy to .env and fill in.  .env is gitignored; never commit a real key.

# Which provider the CLI, API and evaluation harness use: openai | anthropic | mock
CONSILIUM_PROVIDER=mock

# Model id for the selected provider.  Leave unset to use that provider's default.
CONSILIUM_MODEL=

# Credentials.  Only the key for the selected provider is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# CONSILIUM_LOG_LEVEL=INFO
# CONSILIUM_LOG_FORMAT=json          # json | console
# CONSILIUM_RUNS_DIR=runs
# CONSILIUM_CORPUS_DIR=data/corpus
# CONSILIUM_CHROMA_DIR=data/chroma
# CONSILIUM_EPISODIC_DB=data/episodic.db

# Orchestrator: legacy (default, consilium/router/) | adk (consilium/adk/) | langgraph (consilium/graph/)
# ORCHESTRATOR=legacy
# LangGraph only.  How the graph reaches the project's MCP server: inprocess | stdio | http(s)://host:port/mcp
# CONSILIUM_GRAPH_MCP=inprocess
# CONSILIUM_GRAPH_MCP_ARGS=            # extra `consilium mcp-serve` args for the stdio child, e.g. --embedder hash --store numpy
# CONSILIUM_GRAPH_MAX_REPAIRS=2        # validator -> synthesizer rounds before the deterministic repair takes over

# LangSmith tracing of the LangGraph orchestrator.  Off unless LANGSMITH_TRACING=true and a key is set.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=consilium-health
