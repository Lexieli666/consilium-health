# Copy to .env and fill in.  .env is gitignored; never commit a real key.

# Which provider the CLI, API and evaluation harness use: openai | anthropic | mock
CONSILIUM_PROVIDER=mock

# Model id for the selected provider.  Leave unset to use that provider's default.
CONSILIUM_MODEL=

# Credentials.  Only the key for the selected provider is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# CONSILIUM_LOG_LEVEL=INFO
# CONSILIUM_LOG_FORMAT=json          # json | console
# CONSILIUM_RUNS_DIR=runs
# CONSILIUM_CORPUS_DIR=data/corpus
# CONSILIUM_CHROMA_DIR=data/chroma
# CONSILIUM_EPISODIC_DB=data/episodic.db
