# Everything not needed to build the service image.  The build copies an explicit list of paths
# (see Dockerfile), so this mostly keeps the build context small and secrets out of it.
.git
.github
.venv
.env
.env.*
!.env.example
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
runs/
data/chroma/
*.db
*.sqlite3
eval/
tests/
docs/
deploy/
web/*.gif
